rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── /users/{uid} ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ─── /connectedAccounts/{id} ────────────────────────────────────────────
    // Status/health/color fields only — no tokens live here. Written only by
    // Cloud Functions (OAuth callback, sync, health checks).
    match /connectedAccounts/{id} {
      allow read:  if isOwner(resource.data.uid);
      allow write: if false;

      // Tokens — never client-readable or writable, under any circumstance.
      // Split into a subcollection because Firestore rules cannot redact
      // individual fields within one document.
      match /secure/{doc=**} {
        allow read, write: if false;
      }
    }

    // ─── /events/{eventId} ──────────────────────────────────────────────────
    // Cached calendar events, written only by the sync Cloud Function.
    match /events/{eventId} {
      allow read:  if isOwner(resource.data.uid);
      allow write: if false;
    }

    // ─── /slackMessages/{msgId} ─────────────────────────────────────────────
    // Cached Slack messages, written only by the Slack Events webhook.
    match /slackMessages/{msgId} {
      allow read:  if isOwner(resource.data.uid);
      allow write: if false;
    }

    // ─── /reminders/{id} ────────────────────────────────────────────────────
    // User-created tasks/reminders. Unlike events (function-only), these are
    // authored by the client, so owner-scoped read/write is allowed. The
    // scheduler Cloud Function reads them via the Admin SDK (bypasses rules).
    match /reminders/{id} {
      allow read:   if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid) && isOwner(request.resource.data.uid);
      allow delete: if isOwner(resource.data.uid);
    }

    // ─── /settings/{uid} ────────────────────────────────────────────────────
    match /settings/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ─── /sentLog/{uid} ─────────────────────────────────────────────────────
    // Reminder/digest dedup log — internal bookkeeping, Cloud Functions only.
    match /sentLog/{uid} {
      allow read, write: if false;
    }

    // ─── /completionCodes/{code} ────────────────────────────────────────────
    // WhatsApp reply-code → reminder index. Cloud Functions only.
    match /completionCodes/{code} {
      allow read, write: if false;
    }

    // ─── /cultureSources/{id} , /cultureEvents/{id} ─────────────────────────
    // Shared culture catalog and scanned events — any signed-in user may read;
    // written only by the cultureDailyScan Cloud Function.
    match /cultureSources/{id} {
      allow read:  if isAuth();
      allow write: if false;
    }
    match /cultureEvents/{id} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ─── /cultureReviews/{titleKey} ─────────────────────────────────────────
    // Review cache shared across sources — Cloud Functions only.
    match /cultureReviews/{key} {
      allow read, write: if false;
    }
    // ─── /cultureSentLog/{uid} ──────────────────────────────────────────────
    // Culture WhatsApp dedup log — Cloud Functions only.
    match /cultureSentLog/{uid} {
      allow read, write: if false;
    }

    // ─── /oauthState/{stateId} ──────────────────────────────────────────────
    // Short-lived CSRF state for the OAuth connect flow — Cloud Functions only.
    match /oauthState/{stateId} {
      allow read, write: if false;
    }
  }
}
